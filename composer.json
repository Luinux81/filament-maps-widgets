{
    "name": "lbcdev/filament-maps-widgets",
    "description": "Interactive map widgets for Filament panels",
    "keywords": [
        "filament",
        "maps",
        "widgets",
        "leaflet",
        "livewire",
        "laravel"
    ],
    "homepage": "https://github.com/Luinux81/filament-maps-widgets",
    "license": "MIT",
    "authors": [
        {
            "name": "Luinux81",
            "email": "luinux81@gmail.com",
            "role": "Developer"
        }
    ],
    "type": "library",
    "require": {
        "php": "^8.2|^8.3",
        "filament/filament": "^3.0",
        "illuminate/contracts": "^10.0|^11.0|^12.0",
        "spatie/laravel-package-tools": "^1.16",
        "lbcdev/livewire-maps-core": "^1.0.0",
        "lbcdev/map-geometries": "^1.0.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "LBCDev\\FilamentMapsWidgets\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LBCDev\\FilamentMapsWidgets\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "LBCDev\\FilamentMapsWidgets\\FilamentMapsWidgetsServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}